[TEMPLATE]
# Tutoflix (V1) — environment template.
#
# Copy to `.env.local` and fill in. Vite inlines every `VITE_*` value into the
# JavaScript it builds, so the deployed app carries these in plain text: keep
# only keys that are safe to publish (free, rate-limited, restrictable), and put
# anything with real value into the in-app 🔑 panel instead, where it is stored in
# the learner's browser and overrides these defaults.

# TMDB — the whole catalog: search of every movie and TV series, cast and crew,
# seasons, trailers and each title's official streaming destinations.
# Both forms work; the Read Access Token (v4 JWT) is preferred and sent as a
# Bearer header, and the 32-character v3 key is accepted as `?api_key=`.
VITE_TMDB_API_KEY=

# Availability region for the "where to watch" answer. US has the richest
# JustWatch coverage; IR has none at all.
VITE_CATALOG_REGION=US

# YouTube Data API v3 — search of embeddable videos. Free: 10,000 units/day with
# one search costing 100, so about 100 searches a day. Restrict the key to this
# site's HTTP referrers in Google Cloud Console before deploying.
VITE_YOUTUBE_API_KEY=

# Vimeo personal access token — documentary and educational catalog. Left empty
# on purpose: this app ships as a static bundle from a public URL, so a token
# here would be readable by anyone. Paste it once in Discover's 🔑 panel.
# VITE_VIMEO_ACCESS_TOKEN=
