# Cash Arena — build output and install, none of which belongs in the repo.
#
# The repo root already ignores `node_modules` and `dist`, but not `.next` or the
# Next-generated `next-env.d.ts` / tsbuildinfo, and every Next app is expected to
# carry its own file — the arena arrived without one.
node_modules/
.next/
out/
dist/
next-env.d.ts
*.tsbuildinfo

# Nothing secret lives here yet (no database, no API keys — the library and the
# score history are in the browser), but a future `.env.local` must not be
# committed by accident.
.env*
!.env.example
