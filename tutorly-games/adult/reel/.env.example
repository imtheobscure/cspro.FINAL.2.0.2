[TEMPLATE]
# Tutoflix V2 — environment template.
#
# Copy this file to `.env.local` and fill in what you have. Everything here is
# optional: a missing key makes one provider report itself as unconfigured in
# Discover and the others carry on. Dailymotion and playback need no key at all.

# ── Catalog information (TMDB) ────────────────────────────────────────────────
# TMDB: search of every movie and TV series, cast and crew, seasons, trailers and
# each title's official streaming destinations. Free key at themoviedb.org.
# Either value works — the Read Access Token is preferred (sent as a Bearer header)
# and the 32-character v3 key is accepted as a `?api_key=` query parameter.
TMDB_API_KEY=
# TMDB_REGION=US
# TMDB_LANGUAGE=en-US

# IMDb ratings are NOT fetched: OMDb was removed, so no second ratings key exists.
# TMDB still supplies the IMDb id that the information panel links to.

# ── Playable video platforms ──────────────────────────────────────────────────
# Dailymotion needs NO KEY: its public Graph API is open, so Dailymotion search and
# playback work as soon as the app starts.
#
# YouTube search DOES need a key, because the Data API has no anonymous access. It is
# free and takes about three minutes:
#   1. console.cloud.google.com → create (or pick) a project
#   2. APIs & Services → Library → enable “YouTube Data API v3”
#   3. Credentials → Create credentials → API key → paste it below
# Quota is 10,000 units per day and one search costs 100, so roughly 100 searches a
# day, each returning up to 12 embeddable results. Playback itself needs no key: paste
# a YouTube link into the library's “Add video” and it plays with the transcript.
YOUTUBE_API_KEY=

# Vimeo is optional; its catalog leans documentary and educational. Personal access
# token from developer.vimeo.com (create an app, generate a token). Like the YouTube
# key this is read on the server only, so it never ships to a browser.
VIMEO_ACCESS_TOKEN=

# ── Optional infrastructure ───────────────────────────────────────────────────
# DATABASE_URL=            # Postgres; without it the embedded PGlite database is used
# PGLITE_DIR=.pglite       # where the embedded database lives
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3100   # used by the watch-party invites

# ── No sign-in ────────────────────────────────────────────────────────────────
# This build has no login: every request resolves to the local learner profile, so
# no auth variables exist and nothing has to be seeded to start using the app.
